#
#=DESCRIPTION unix peer address using quoted alternation
# Even though the parser should fail with this since it was supposed
# to fail with an error message of invalid variable name, we are
# supporting it due to historical reasons and because we don't want
# existing policy to regress
#=EXRESULT PASS

profile a_profile {
  unix connect peer=(addr="@{alt1,alt2}-test"),
}
