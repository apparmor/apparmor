abi <abi/4.0>,

include <tunables/global>

profile postfix-scache /usr/lib{,exec}/postfix/{bin/,sbin/,}scache flags=(attach_disconnected.path=/att/postfix-scache/) {
  include <abstractions/base>
  include <abstractions/nameservice>
  include <abstractions/postfix-common>

  owner /att/postfix-scache/var/spool/postfix/private/dovecot-lmtp rw,

  /usr/lib{,exec}/postfix/{bin/,sbin/,}scache mrix,

  # Site-specific additions and overrides. See local/README for details.
  include if exists <local/postfix-scache>
}
